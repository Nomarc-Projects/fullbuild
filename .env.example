# --- public (exposed to client) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=

# --- server only ---
AUTH_SECRET=change_me_min_16_chars
AUTH_URL=http://localhost:3000

# Google OAuth (Auth.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments — leave blank for demo mode (no real charges). Set a provider's
# secret to go live; PAYMENT_PROVIDER forces a specific one when several are set.
# Multivendor: vendor subaccounts + transaction split settle vendors directly;
# Dedicated Virtual Accounts (per-vendor bank-transfer payin) need DVA activation.
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
SEERBIT_PUBLIC_KEY=
SEERBIT_SECRET_KEY=
